{
  "name": "silunet",
  "version": "1.0.0",
  "description": "Juego de adivinanza de siluetas en tiempo real",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "test:unit": "c8 --all --include=src/lamport.ts --include=src/mutex.ts --include=src/wordBank.ts --check-coverage --lines=90 --statements=90 --functions=90 --branches=85 --reporter=text --reporter=html --reporter=lcov --reporter=json-summary --reports-dir=coverage tsx --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/unit/junit.xml test/unit/SilunetTest.ts",
    "test:junit": "npm run build && node scripts/run-maven.js test",
    "test:selenium": "npm run build && node scripts/run-maven.js test -Pselenium",
    "test:selenium:headed": "npm run build && node scripts/run-maven.js test -Pselenium -DseleniumHeadless=false",
    "vv:concurrencia": "node vv/concurrencia-lamport.js",
    "vv:caos": "node vv/caos-coordinador.js"
  },
  "dependencies": {
    "pg": "^8.22.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.13",
    "c8": "^12.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
